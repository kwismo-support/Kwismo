{
  "expo": {
    "name": "Kwismo",
    "slug": "kwismo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kwismo",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kwismo.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.kwismo.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "READ_CALL_LOG",
        "WRITE_CALL_LOG",
        "READ_PHONE_STATE",
        "CALL_PHONE",
        "READ_PHONE_NUMBERS",
        "READ_SMS",
        "RECEIVE_SMS",
        "SEND_SMS",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "POST_NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "appEnv": "preview",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5dfc0edb-3e81-4bed-b9c2-448832f4b5ec"
      }
    },
    "owner": "kwismo"
  }
}
