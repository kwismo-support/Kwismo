{
  "expo": {
    "name": "Kwismo",
    "slug": "kwismo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kwismo",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/5dfc0edb-3e81-4bed-b9c2-448832f4b5ec",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kwismo.mobile",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSContactsUsageDescription": "Kwismo a besoin d'accéder à vos contacts pour analyser la réputation des numéros et vous protéger contre les tentatives de fraude.",
        "NSCameraUsageDescription": "Kwismo a besoin d'accéder à votre appareil photo pour vous permettre de prendre votre photo de profil.",
        "NSPhotoLibraryUsageDescription": "Kwismo a besoin d'accéder à vos photos pour vous permettre de choisir une photo de profil.",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.kwismo.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "READ_CALL_LOG",
        "WRITE_CALL_LOG",
        "READ_PHONE_STATE",
        "CALL_PHONE",
        "READ_PHONE_NUMBERS",
        "READ_SMS",
        "RECEIVE_SMS",
        "SEND_SMS",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "POST_NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#161E33"
        }
      ],
      "expo-updates",
      [
        "expo-contacts",
        {
          "contactsPermission": "Kwismo utilise vos contacts pour identifier les numéros fiables et détecter les fraudes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kwismo accède à vos photos pour personnaliser votre avatar.",
          "cameraPermission": "Kwismo utilise la caméra pour prendre votre photo de profil."
        }
      ]
    ],
    "extra": {
      "appEnv": "preview",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5dfc0edb-3e81-4bed-b9c2-448832f4b5ec"
      }
    },
    "owner": "kwismo"
  }
}
