{
  "expo": {
    "name": "Kwismo",
    "slug": "kwismo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kwismo",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kwismo.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.kwismo.mobile"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#161E33"
        }
      ]
    ],
    "extra": {
      "appEnv": "preview",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5dfc0edb-3e81-4bed-b9c2-448832f4b5ec"
      }
    },
    "owner": "kwismo"
  }
}
