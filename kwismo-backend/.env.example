# KWISMO Backend — variables d'environnement
# Copie ce fichier en .env et adapte les valeurs.

# Type de base de donnees : sqlite | postgresql | mysql
DB_TYPE="sqlite"

# Connexion base de donnees
DATABASE_URL="file:./dev.db"

# Cle de signature des JWT (aleatoire, longue, jamais partagee)
JWT_SECRET="changeme-generate-a-long-random-secret"
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7

# URL du service IA (kwismo-ai) + delai max avant repli sur les regles expertes
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_TIMEOUT_SECONDS=5.0

# Duree de vie d'un OTP (email ou sms)
OTP_EXPIRE_MIN=5

# Origines autorisees (CORS strict) et hotes autorises (anti Host-header injection)
CORS_ORIGINS="http://localhost:5173"
ALLOWED_HOSTS="*"

# Cache / limitation de debit / files d'attente (optionnel)
REDIS_URL="redis://localhost:6379"

# Limitation de debit : "memory://" en dev (zero dependance), passer a
# l'URL Redis ci-dessus en prod multi-workers pour partager les compteurs.
RATE_LIMIT_STORAGE_URI="memory://"
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_OTP="5/minute"

# Garde-fou anti-surcharge : taille max du corps d'une requete (Mo)
MAX_REQUEST_BODY_MB=5

# Stockage fichiers (pas encore de route d'upload, config prete pour plus tard)
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_EXTENSIONS="jpg,jpeg,png,webp"
ALLOWED_VIDEO_EXTENSIONS="mp4,mov,webm"
