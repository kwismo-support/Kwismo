# KWISMO Backend — variables d'environnement
# Copie ce fichier en .env et adapte les valeurs.

# Type de base de donnees : sqlite | postgresql | mysql
DB_TYPE="sqlite"

# Connexion base de donnees
DATABASE_URL="file:./dev.db"

# Cle de signature des JWT (aleatoire, longue, jamais partagee)
JWT_SECRET="changeme-generate-a-long-random-secret"
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7

# URL du service IA (kwismo-ai)
AI_SERVICE_URL="http://localhost:8001"

# Duree de vie d'un OTP (email ou sms)
OTP_EXPIRE_MIN=5

# Origines autorisees (CORS strict)
CORS_ORIGINS="http://localhost:5173"

# Cache / limitation de debit / files d'attente (optionnel)
REDIS_URL="redis://localhost:6379"
