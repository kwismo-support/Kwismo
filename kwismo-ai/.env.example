# KWISMO Modele IA — variables d'environnement
# Copie ce fichier en .env et adapte les valeurs. Ne jamais committer .env.

# URL du backend
BACKEND_URL="http://localhost:8000"

# Dossier des artefacts entraines (volume Docker)
MODEL_DIR="./models"

# Versions des modeles a charger
MODEL_A_VERSION="latest"
MODEL_B_VERSION="latest"

# Modele de langue africain de base (fine-tuning du Modele B)
HF_MODEL_NAME="Davlan/afro-xlmr-base"

# Seuil de decision (reglable sans reentrainer)
PREDICT_THRESHOLD=0.5

# Limitation de debit anti-surcharge ("memory://" = zero dependance externe)
RATE_LIMIT_STORAGE_URI="memory://"
RATE_LIMIT_DEFAULT="300/minute"

# Garde-fou anti-surcharge : taille max du corps d'une requete (Mo)
MAX_REQUEST_BODY_MB=2

# Scraping
SCRAPER_USER_AGENT="KWISMO-DataCollector/1.0"
SCRAPER_DELAY_SECONDS=3.0
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_TIMEOUT_SECONDS=15.0
SCRAPER_MAX_RETRIES=3
# Proxy optionnel, uniquement si l'entreprise en possede deja un legitime
SCRAPER_PROXY_URL=""
SCRAPER_SEARCH_REGION="fr-fr"
SCRAPER_MAX_RESULTS_PER_KEYWORD=10

# Comptes D'ENTREPRISE dedies au scraping — plusieurs possibles, "user1:pass1,user2:pass2"
# (essayes dans l'ordre, jamais de bascule automatique silencieuse). Ne jamais committer .env.
FACEBOOK_ACCOUNTS=""
INSTAGRAM_ACCOUNTS=""
X_ACCOUNTS=""
