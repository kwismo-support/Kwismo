# ============================================================
# EAS Build ignore patterns - Monorepo root
# NOTE: Patterns with a leading "/" only match at the repo root,
# ensuring internal folders like kwismo-mobile/src/shared are NOT ignored!
# ============================================================

# Git repository & history (root only)
/.git
/.git/**

# Editor / IDE tools (root only)
/.github
/.github/**
/.vscode
/.vscode/**
/.claude
/.claude/**
/.vercel
/.vercel/**
/.idea
/.idea/**
/scratch
/scratch/**

# Other non-mobile monorepo projects (root only)
/kwismo-web
/kwismo-web/**
/kwismo-backend
/kwismo-backend/**
/kwismo-ai
/kwismo-ai/**
/shared
/shared/**

# Documentation, marketing & design files (root only)
/branding
/branding/**
/cadrage
/cadrage/**
/cahiers des charges
/cahiers des charges/**
/diagrammes
/diagrammes/**
/docs
/docs/**
/maquettes
/maquettes/**
/marketing
/marketing/**
/plan economique
/plan economique/**
/plan strategique
/plan strategique/**
/reunions
/reunions/**
/*.pdf
/*.zip
/*.rar
/*.tar.gz

# Build outputs & caches (anywhere)
dist/
dist/**
**/dist/**
.expo/
.expo/**
**/.expo/**
node_modules/
node_modules/**
**/node_modules/**
web-build/
web-build/**
**/web-build/**
coverage/
coverage/**
**/coverage/**

# Logs & temp files
*.log
**/*.log
.DS_Store
Thumbs.db

# Python & Backend leftovers
.venv/
.venv/**
**/.venv/**
__pycache__/
__pycache__/**
**/__pycache__/**
*.pyc
**/*.pyc
*.db
**/*.db
*.sqlite*
**/*.sqlite*
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/

# Test files not needed for production build
**/__tests__
**/__tests__/**
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
